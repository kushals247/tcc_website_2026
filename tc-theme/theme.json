{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "tc-white", "color": "#FFFFFF", "name": "T&C White" },
        { "slug": "tc-yellow", "color": "#FFCD00", "name": "T&C Yellow (Pantone 116 C)" },
        { "slug": "tc-grey", "color": "#63666A", "name": "T&C Cool Gray (Pantone Cool Gray 10 C)" },
        { "slug": "tc-grey-light", "color": "#F5F6F7", "name": "T&C Light Grey (subtle backgrounds)" },
        { "slug": "tc-grey-border", "color": "#ECECEC", "name": "T&C Border Grey (dividers)" }
      ],
      "custom": false,
      "customGradient": false
    },
    "typography": {
      "fontFamilies": [
        { "slug": "primary", "name": "Primary (Montserrat as Gotham fallback)", "fontFamily": "'Montserrat', 'Gotham', system-ui, -apple-system, sans-serif" },
        { "slug": "display", "name": "Display (Montserrat Medium)", "fontFamily": "'Montserrat', 'Gotham', system-ui, -apple-system, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "sm", "size": "14px", "name": "Small" },
        { "slug": "base", "size": "16px", "name": "Base" },
        { "slug": "lg", "size": "18px", "name": "Large" },
        { "slug": "xl", "size": "24px", "name": "Extra Large" },
        { "slug": "2xl", "size": "32px", "name": "Display Small" },
        { "slug": "3xl", "size": "44px", "name": "Display Medium" },
        { "slug": "4xl", "size": "64px", "name": "Display Large" }
      ]
    },
    "spacing": {
      "spacingScale": { "operator": "*", "increment": 1.5, "steps": 7, "mediumStep": 1, "unit": "rem" }
    }
  }
}
